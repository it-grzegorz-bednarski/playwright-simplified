ENVIRONMENT=dev

# ============================================
# Github Token
# ============================================
GITHUB_TOKEN=ghp_q7mN2xR9vLp4tC8bK3dF1sH6jY0wZ5nU2aE

# ============================================
# Slack Reporter
# ============================================
SLACK_BOT_USER_OAUTH_TOKEN=xoxb-271904563812-940176235408-vN7qLm2sKp9Tz4dYw8rBc6He
SLACK_REPORT_ENABLED=false

# ============================================
# Teams Reporter
# ============================================
TEAMS_REPORT_ENABLED=false

# Webhook URLs - define your Teams channels/integrations here
# (Keep these in your .env.dev / .env.local, not in version control)
TEAMS_WEBHOOK_SUCCESS_CHANNEL=https://your-organization.webhook.office.com/webhookb2/...
TEAMS_WEBHOOK_FAILURE_CHANNEL=https://your-organization.webhook.office.com/webhookb2/...

# (Optional) Reference webhook keys in config to route success/failure notifications
# Example config usage:
#   onSuccessWebhookKeys: ['generalChannel'],
#   onFailureWebhookKeys: ['generalChannel', 'failureChannel'],

# ============================================
# API
# ============================================
# Base URL for API-only session login flows (e.g. sessionLogin.dummyjson.ts)
API_URL=https://dummyjson.com

# ============================================
# Percy Visual Testing
# ============================================
# Required for running visual regression tests via Percy.
# Get your project token from: https://app.percy.io/
# See [Visual Testing](../docs/visualTesting.md#configuration) for more details.
PERCY_TOKEN=web_480b97bac201fbeab51cf8ef2892a980a6a5b460c125e82c0474c266dc902252
PERCY_BRANCH=example

# ============================================
# Basic Auth (optional)
# ============================================
# Global Basic Auth for the whole environment/domain
BASICAUTH_USERNAME=admin
BASICAUTH_PASSWORD=admin

# Optional per-user Basic Auth overrides
ADMIN_BASICAUTH_USERNAME=admin
ADMIN_BASICAUTH_PASSWORD=admin.super-secret

# ============================================
# BRANDS Registry
# ============================================
BRANDS=SINGLELOCALE,MULTILOCALE

# ============================================
# SINGLELOCALE: Single-Locale Brand
# ============================================
SINGLELOCALE_LOCALES=US

SINGLELOCALE_TENANT_US=en_US
SINGLELOCALE_BASE_URL_US=https://example.com?locale=us
SINGLELOCALE_USER_US=demo_singlelocale
SINGLELOCALE_PASSWORD_US=secret_singlelocale

# Session manager credentials examples
# - Single-locale fallback (resolveCreds('ADMIN') without envByLocale)
# - Also used by dummyjson.com API tests (emilys is a valid dummyjson test user)
ADMIN_USERNAME=emilys
ADMIN_PASSWORD=emilyspass
# - Single-locale brand-scoped (resolveCreds('ADMIN') with envByLocale in SINGLELOCALE-US project)
SINGLELOCALE_ADMIN_USERNAME_US=single_admin_us
SINGLELOCALE_ADMIN_PASSWORD_US=single_password_us

# ============================================
# MULTILOCALE: Multi-Locale Brand with Regional Groups
# ============================================
MULTILOCALE_LOCALES=PL,CS,DE,AR

# Fallback locale: if a value is missing for a locale, fall back to this one
MULTILOCALE_FALLBACK_LOCALE=PL

# Tenant/Locale mappings (optional)
MULTILOCALE_TENANT_PL=pl_PL
MULTILOCALE_TENANT_CS=cs_CZ
MULTILOCALE_TENANT_DE=de_DE
MULTILOCALE_TENANT_AR=ar_AE

# Base URLs per locale (required for each locale)
MULTILOCALE_BASE_URL_PL=https://example.com?locale=pl
MULTILOCALE_BASE_URL_CS=https://example.com?locale=cs
MULTILOCALE_BASE_URL_DE=https://example.com?locale=de
MULTILOCALE_BASE_URL_AR=https://example.com?locale=ar

# Credentials per locale (optional, only define if login exists)
MULTILOCALE_USER_PL=demo_pl
MULTILOCALE_PASSWORD_PL=secret_pl
MULTILOCALE_USER_CS=demo_cs
MULTILOCALE_PASSWORD_CS=secret_cs
MULTILOCALE_USER_AR=demo_ar
MULTILOCALE_PASSWORD_AR=secret_ar

# Locale-aware userId values used by POM URL templates
MULTILOCALE_USER_ID_PL=user_id_pl
MULTILOCALE_USER_ID_CS=user_id_cs
MULTILOCALE_USER_ID_DE=user_id_de
MULTILOCALE_USER_ID_AR=user_id_ar

# Session manager credentials examples for multi-locale project
# resolveCreds('ADMIN') + envByLocale in MULTILOCALE-<locale> projects
MULTILOCALE_ADMIN_USERNAME_PL=multi_admin_pl
MULTILOCALE_ADMIN_PASSWORD_PL=multi_password_pl
MULTILOCALE_ADMIN_USERNAME_CS=multi_admin_cs
MULTILOCALE_ADMIN_PASSWORD_CS=multi_password_cs

# Optional per-locale Basic Auth for MULTILOCALE project
MULTILOCALE_BASICAUTH_USERNAME_PL=admin_pl
MULTILOCALE_BASICAUTH_PASSWORD_PL=secret_pl
MULTILOCALE_BASICAUTH_USERNAME_CS=admin_cs
MULTILOCALE_BASICAUTH_PASSWORD_CS=secret_cs

# Optional per-locale per-user Basic Auth for MULTILOCALE project
MULTILOCALE_ADMIN_BASICAUTH_USERNAME_PL=admin_pl_special
MULTILOCALE_ADMIN_BASICAUTH_PASSWORD_PL=secret_pl_special
MULTILOCALE_ADMIN_BASICAUTH_USERNAME_CS=admin_cs_special
MULTILOCALE_ADMIN_BASICAUTH_PASSWORD_CS=secret_cs_special

# Optional per-locale API URLs for MULTILOCALE project
MULTILOCALE_API_URL_PL=https://pl.api.example.com
MULTILOCALE_API_URL_CS=https://cs.api.example.com

# Regional groups: app auto-generates @<groupname> tags from group names
MULTILOCALE_GROUP_SLAVIC=PL,CS
MULTILOCALE_GROUP_RTL=AR

# Optional per-brand execution controls
MULTILOCALE_DISABLED_LOCALES=
MULTILOCALE_LOCALE_OVERRIDE=
